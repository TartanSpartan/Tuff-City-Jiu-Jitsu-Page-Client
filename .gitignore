# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test

# production
/build
test/
/dist
/.next
/.parcel-cache

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
progress_log

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# sensitive information
# consider tweaking the below ignore rules if e.g. signatures end up getting downloaded to this folder
# /public/images
/public/uploads
/public/temp

# Ignore backup files
*.backup
*.orig
*.old

# Ignore source map files in build outputs (already ignoring /build, but be explicit)
/build/static/js/*.map

# Ignore documentation user payload files
Documentation/RailsAPIUserPayload.md
src/components/AdminFormOverflow.js
src/components/AdminFormSimple.js
src/components/NewTechniqueFormSimple.js


# IDE specific files
.idea/ # JetBrains (RubyMine, IntelliJ)
.vscode/ # VS Code

